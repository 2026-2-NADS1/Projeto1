        <mxCell id="HINwRFB9dHy-Vc303DcA-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#1BA1E2,#9999FF);fontColor=#ffffff;strokeColor=light-dark(#006EAF,#CCCCFF);" value="&lt;font style=&quot;font-size: 21px; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Aplicação&lt;/b&gt;&lt;/font&gt;" vertex="1">
